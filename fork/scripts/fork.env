# Fork (Owner): the hosts and IDs the fork's scripts use, in one place. Every
# script sources this file from its own directory, so it ships in
# fork-scripts.tar.gz and is installed beside each script copied to ~/t3-fork.
# check-literals.sh fails when one of these values, or any other tailnet host,
# Mac host name, tailnet IP or home directory, is written into another fork file.

# The fork's GitHub repository: its releases, and its "Fork sync failed" issue.
fork_repo=owner/t3code
# The build Mac (build-mac): its T3 Code server over Tailscale Serve, and on :8444
# its build outputs (install-jobs.sh artifacts), which every Mac downloads.
build_mac_url=https://build-mac-host.example.ts.net
artifacts_url=$build_mac_url:8444
# The LaunchAgent that opens Aside at login, which install-aside-helper.sh replaces.
aside_login_label=com.example.aside-browser
