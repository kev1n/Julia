# Fork: the names, hosts and IDs the fork's scripts use, in one place. Every
# script sources this file from its own directory, so it ships in
# fork-scripts.tar.gz and is installed beside each script copied to ~/t3-fork.
# The values here are neutral defaults. Your own values go in
# ~/.config/julia/fork.env (same variable names, shell syntax), which this file
# reads below; the path is fixed so launchd jobs, which have no shell
# profile, read it too. FORK.md documents every variable.

# The fork's GitHub repository (owner/name): its releases and its "Fork sync
# failed" issue. Empty: sync.sh and the deploy jobs refuse to publish or pull.
fork_repo=
# The branch the daily sync rebases and pushes.
fork_branch=main
# The word in fork versions (<nightly>.<word>.<epoch>+<word>.<sha>) and release
# tags (<word>-<nightly>-<sha>).
version_label=fork
# Prefix of the fork's LaunchAgent labels (<prefix>.sync, .deploy, ...).
job_label_prefix=dev.julia.fork
# The LaunchAgent that opens Aside at login, which install-aside-helper.sh
# disables while Aside runs under the helper. Empty: there is none.
aside_login_label=
# The desktop app: bundle id; package name, which names its keychain item and
# its Chromium profile folder under ~/Library/Application Support; the folder in
# $HOME that holds its own state. build.sh embeds them in the app.
desktop_bundle_id=dev.julia.app
desktop_package_name=julia
desktop_home_dirname=.julia-app
# An older desktop app name (in /Applications) that install-desktop.sh replaces
# with Julia.app. Empty: none.
desktop_legacy_app=
# The Android app (build-mobile.sh): package id, URL scheme, the APK's file name
# (without .apk), and its release signing key and that key's password file.
mobile_package=dev.julia.app
mobile_scheme=julia
mobile_apk_name=Julia
mobile_keystore=$HOME/t3-fork/keys/julia-release.jks
mobile_keystore_pass=$HOME/t3-fork/keys/julia-release.pass
# The build Mac's T3 Code server, as every other machine reaches it (for
# example over Tailscale Serve). Its build outputs (install-jobs.sh artifacts)
# are served at artifacts_url, which defaults to port 8444 of the same host.
build_mac_url=
artifacts_url=

# Your values.
fork_local_config="$HOME/.config/julia/fork.env"
if [ -f "$fork_local_config" ]; then . "$fork_local_config"; fi
# Values derived from the ones above, so an override of the base value carries.
if [ -z "$artifacts_url" ] && [ -n "$build_mac_url" ]; then artifacts_url=$build_mac_url:8444; fi

# fork_require <name>...: fails, saying where to set it, unless every named value is set.
fork_require() {
  local name
  for name in "$@"; do
    [ -n "${!name}" ] || { echo "$name is not set: set it in $fork_local_config (FORK.md)." >&2; return 1; }
  done
}
# fork_platform: the server runtime this machine installs (t3-<version>-<fork_platform>.tar.gz):
# darwin-arm64 on the Macs, linux-x64 on Linux machines, where systemd replaces launchd.
case "$(uname -s)" in
  Linux) fork_platform=linux-x64 ;;
  *) fork_platform=darwin-arm64 ;;
esac
# fork_release_files <SHA256SUMS>: the lines of a release's checksums this machine downloads.
# A Linux machine takes only its runtime archive; a Mac takes every file but that one.
fork_release_files() {
  if [ "$fork_platform" = linux-x64 ]; then grep -- "-linux-x64\.tar\.gz$" "$1"; else grep -v -- "-linux-x64\.tar\.gz$" "$1"; fi
}
# fork_sha256_check: sha256sum -c on Linux (Ubuntu minimal has no shasum), shasum on macOS.
fork_sha256_check() {
  if [ "$fork_platform" = linux-x64 ]; then sha256sum -c "$@"; else shasum -a 256 -c "$@"; fi
}
# fork_install: install(1) that puts a new file in place, so a running script keeps its own
# bytes (replace-running-scripts.test.sh). BSD install needs -S for that; GNU install always
# unlinks the old file first, and its -S means something else.
fork_install() {
  if [ "$fork_platform" = linux-x64 ]; then install "$@"; else install -S "$@"; fi
}
# fork_desktop_installed: whether this Mac has the fork's desktop app (or its older name).
fork_desktop_installed() {
  [ -d /Applications/Julia.app ] || { [ -n "$desktop_legacy_app" ] && [ -d "/Applications/$desktop_legacy_app.app" ]; }
}
